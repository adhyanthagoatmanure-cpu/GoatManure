# ── Database ──────────────────────────────────────────────────────────────
# Use a MySQL connection string for GoDaddy/production deployment.
# Local MySQL can be started with: docker compose up -d mysql
# PostgreSQL remains available in Docker for compatibility checks until MySQL is verified.
DATABASE_URL=""

# ── Auth (required) ──────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""

# ── Google OAuth (optional — Google login is hidden/disabled until set) ───
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ── Facebook Login (optional — hidden/disabled until set) ─────────────────
# developers.facebook.com -> your app -> Facebook Login -> Settings
# Valid OAuth Redirect URI: {NEXTAUTH_URL}/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ── PayU India Hosted Checkout (required for online checkout) ─────────────
# Use the merchant key and salt from the same PayU environment. Production
# requires a publicly reachable HTTPS NEXTAUTH_URL (not localhost).
# The callback URL is {NEXTAUTH_URL}/api/payment/payu/callback and must be
# publicly reachable over HTTPS in production.
PAYU_MERCHANT_KEY=""
PAYU_MERCHANT_SALT=""
PAYU_ENV="production"

# ── Legacy Razorpay API routes (not used by the current checkout) ─────────
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
NEXT_PUBLIC_RAZORPAY_KEY_ID=""

# ── SMTP (optional — emails are logged to the server console until set) ───
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM=""
ADMIN_NOTIFICATION_EMAIL=""

# ── WhatsApp admin order alerts (optional — alerts are logged until set) ──
# Meta WhatsApp Cloud API credentials. The admin phone number must use E.164
# format, for example +919876543210.
# Set these only after an Authentication template has been approved and verified.
WHATSAPP_OTP_TEMPLATE_NAME=""
WHATSAPP_OTP_TEMPLATE_LANGUAGE=""
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_ADMIN_PHONE_NUMBER=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# ── Site ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="ADHYANTHA Goat Manure"
